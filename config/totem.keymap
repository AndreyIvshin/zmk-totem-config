#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        vibranium {
            bindings = <
                &kp X  &kp W  &kp M                &kp G                    &kp Q      &kp SLASH      &kp DOT          &kp APOSTROPHE       &kp J  &kp B
                &kp S  &kp C  &kp N                &kp T                    &kp K      &kp COMMA      &kp A            &kp E                &kp I  &kp H
&mt LSHIFT TAB  &kp V  &kp P  &kp L                &kp D                    &kp Z      &kp SEMICOLON  &kp U            &kp O                &kp Y  &kp F  &mt RIGHT_SHIFT ENTER
                              &mt LEFT_ALT INSERT  &mt LEFT_CONTROL ESCAPE  &lt 1 R    &lt 2 SPACE    &lt 3 BACKSPACE  &mt LEFT_WIN DELETE
            >;
        };

        symbols {
            bindings = <
        &kp F10  &kp F9  &kp F8  &kp F7  &kp PRINTSCREEN    &kp BSLH             &kp N7                       &kp N8                &kp N9  &kp N0
        &kp F11  &kp F6  &kp F5  &kp F4  &trans             &kp MINUS            &kp N4                       &kp N5                &kp N6  &kp EQUAL
&trans  &kp F12  &kp F3  &kp F2  &kp F1  &kp CAPSLOCK       &kp LBKT             &kp N1                       &kp N2                &kp N3  &kp RBKT   &kp GRAVE
                         &trans  &trans  &trans             &mt RIGHT_ALT SPACE  &mt RIGHT_CONTROL BACKSPACE  &mt RIGHT_WIN DELETE
            >;
        };

        mouse {
            bindings = <
        &kp LC(LG(LEFT_ARROW))  &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)      &kp LC(LG(RIGHT_ARROW))  &trans       &trans  &trans  &trans  &trans  &trans
        &mmv (MOVE_X(-1500))    &mmv MOVE_Y(1500)   &mmv (MOVE_Y(-1500))  &mmv MOVE_X(1500)        &trans       &trans  &trans  &trans  &trans  &trans
&trans  &msc SCRL_LEFT          &msc SCRL_DOWN      &msc SCRL_UP          &msc SCRL_RIGHT          &trans       &trans  &trans  &trans  &trans  &trans  &trans
                                                    &mkp RCLK             &trans                   &mkp LCLK    &trans  &trans  &trans
            >;
        };

        navigation {
            bindings = <
        &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &trans    &trans  &trans  &trans  &trans  &trans
        &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT_ARROW      &trans    &trans  &trans  &trans  &trans  &trans
&trans  &kp HOME            &kp PAGE_DOWN       &kp PAGE_UP       &kp END              &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans            &trans               &trans    &trans  &trans  &trans
            >;
        };
    };
};
